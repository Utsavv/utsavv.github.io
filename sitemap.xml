---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign excluded_urls = '/404.html,/robots.txt,/sitemap.xml' | split: ',' %}
  {% for page in site.html_pages %}
    {% unless excluded_urls contains page.url %}
      {% unless page.sitemap == false %}
  <url>
    <loc>{{ page.url | replace: 'index.html', '' | absolute_url }}</loc>
    <lastmod>{{ page.date | default: site.time | date_to_xmlschema }}</lastmod>
  </url>
      {% endunless %}
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | replace: 'index.html', '' | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
